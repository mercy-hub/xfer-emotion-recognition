<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/xfer-emonto"
         xmlns="http://example.org/xfer-emonto#">

<owl:Ontology rdf:about="http://example.org/xfer-emonto"/>

<owl:ObjectProperty rdf:about="#hasConfiguration">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Emotion"/>
  <rdfs:range rdf:resource="#AUConfiguration"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#includesAU">
  <rdfs:domain rdf:resource="#AUConfiguration"/>
  <rdfs:range rdf:resource="#ActionUnit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#movesRegion">
  <rdfs:domain rdf:resource="#ActionUnit"/>
  <rdfs:range rdf:resource="#FacialRegion"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#measuredBy">
  <rdfs:domain rdf:resource="#ActionUnit"/>
  <rdfs:range rdf:resource="#Measurement"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#substitutedBy">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActionUnit"/>
  <rdfs:range rdf:resource="#ActionUnit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#pairMember">
  <rdfs:domain rdf:resource="#ConfusablePair"/>
  <rdfs:range rdf:resource="#Emotion"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#correlatedWith">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Source"/>
  <rdfs:range rdf:resource="#Source"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#claimsAU">
  <rdfs:domain rdf:resource="#Evidence"/>
  <rdfs:range rdf:resource="#ActionUnit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#fromSource">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Evidence"/>
  <rdfs:range rdf:resource="#Source"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#blendshapeName">
  <rdfs:domain rdf:resource="#Measurement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#measurable">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ActionUnit"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#auWeight">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#AUConfiguration"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#classIndex">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Emotion"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Emotion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Re-declared from EMONTO (Graterol et al., 2021): an emotion category.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Source">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Re-declared from EMONTO: a recognition method that produces evidence.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Evidence">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Re-declared from EMONTO, extended: a symbolic claim made by a source.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ActionUnit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: a FACS action unit (Ekman and Friesen, 1978).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#FacialRegion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: one of the seven regions used by the region explanations.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AUConfiguration">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: the prototype action units of an emotion (Table 11).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Measurement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: a MediaPipe blendshape score read as an action-unit proxy.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ConfusablePair">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: two emotions that are easily mistaken for each other.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Decision">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Extension: the output of the reasoner.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LabelDecision">
  <rdfs:subClassOf rdf:resource="#Decision"/>
</owl:Class>

<owl:Class rdf:about="#BlendDecision">
  <rdfs:subClassOf rdf:resource="#Decision"/>
</owl:Class>

<owl:Class rdf:about="#Abstention">
  <rdfs:subClassOf rdf:resource="#Decision"/>
</owl:Class>

<owl:Class rdf:about="#BrowEmotion">
  <rdfs:subClassOf rdf:resource="#Emotion"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Emotion"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasConfiguration"/>
          <owl:someValuesFrom>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#includesAU"/>
              <owl:someValuesFrom>
                <owl:Restriction>
                  <owl:onProperty rdf:resource="#movesRegion"/>
                  <owl:hasValue rdf:resource="#brows"/>
                </owl:Restriction>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:someValuesFrom>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#MouthOnlyAU">
  <rdfs:subClassOf rdf:resource="#ActionUnit"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#ActionUnit"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#movesRegion"/>
          <owl:allValuesFrom rdf:resource="#FacialRegion"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#movesRegion"/>
          <owl:hasValue rdf:resource="#mouth"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:NamedIndividual rdf:about="#forehead">
  <rdf:type rdf:resource="#FacialRegion"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#brows">
